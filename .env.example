# NodeLx Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to Git

# Auth
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_64_CHARS
JWT_EXPIRES_IN=24h
COOKIE_NAME=nodelx_session

# Server
PORT=3001
NODE_ENV=development

# GitHub sync (optional — leave blank to work fully offline)
# Fine-grained PAT scoped to ONE repo with "Contents: Read and write".
# Never commit the real token; add it to .env (which is gitignored).
GITHUB_PAT=
GITHUB_OWNER=your-username-or-org
GITHUB_REPO=objectivewire
GITHUB_BRANCH=main
GITHUB_BASE_PATH=

# Bridge API key — the client site's admin panel authenticates to NodeLx
# with this value. Set to a long random string; also set it in the client's
# .env.local as NODELX_API_KEY.
NODELX_API_KEY=
