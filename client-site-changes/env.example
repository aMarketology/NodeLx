# ─────────────────────────────────────────────────────────────────────────────
# Client Repo Environment Variables (williamb_constuction)
# Copy to `.env.local` in the client repo. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# NodeLx headless backend URL
NODELX_URL=https://nodelx-production.up.railway.app

# Bridge API key — must match NODELX_API_KEY on the NodeLx server
NODELX_API_KEY=nxk_0a4d7185e4c7b64e62873d4b4b567d187977

# Site id registered in NodeLx (content/sites.json)
NODELX_SITE_ID=williamb-construction

# Client admin login — the password the client types at /admin/login
ADMIN_PASSWORD=change-me

# Cookie value — a random secret string. Must NOT equal ADMIN_PASSWORD.
# The login route sets nodelx_admin_session = ADMIN_SECRET.
ADMIN_SECRET=change-me-to-a-random-string

# ISR revalidation secret — must match REVALIDATION_SECRET on the NodeLx server
REVALIDATION_SECRET=2d7251628ac41493431ae719dde1d50212a0acc7a0406439

# Optional: GitHub owner/repo for lib/cms.ts content reads.
# Defaults are already hardcoded in lib/cms.ts (ironoak-texas/williamb_constuction).
# GITHUB_OWNER=ironoak-texas
# GITHUB_REPO=williamb_constuction
# GITHUB_TOKEN=            # optional, avoids GitHub API rate limits in prod